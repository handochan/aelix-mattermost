# Environment for the container (docker compose env_file). Copy to provider.env and
# chmod 600. Aelix resolves a models.json "apiKey" that names a variable from here.
# Values are visible to "docker inspect" and to any tool you allow in the container.
INTERNAL_LLM_API_KEY=replace-me

# Optional egress proxy for model traffic (see docs/docker.md, "Restricting egress").
# HTTPS_PROXY=http://egress-proxy:3128
# NO_PROXY=localhost,127.0.0.1
