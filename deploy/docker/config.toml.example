# Container configuration for deploy/docker/compose.yaml, mounted read-only at
# /etc/aelix-mattermost/config.toml. All paths are container paths. No secrets here:
# the bot token is the Docker secret "mattermost_token".

[mattermost]
url = "https://mattermost.example.internal"
# Takes precedence over token_env.
token_file = "/run/secrets/mattermost_token"
# User IDs, not @usernames. Replace this before running.
allowed_users = ["REPLACE_WITH_YOUR_MATTERMOST_USER_ID"]
# Admins approve pairing requests with `!pair` in a DM; pairing gives unknown users a code.
admins = []
pairing = false
# Empty: allowed users may invoke the bot in any channel/group it has joined.
allowed_channels = []
allow_all_users = false
require_mention = true
allow_insecure_http = false
# Internal CA for the Mattermost connection; mount it read-only (see compose.yaml).
# ca_file = "/etc/aelix-mattermost/internal-ca.pem"
max_post_chars = 3500

[aelix]
# Installed in the image. Children inherit HOME and AELIX_CODING_AGENT_DIR from it.
command = ["aelix"]
# provider/model from models.json (/var/lib/aelix-mattermost/aelix-agent/models.json).
model = "internal/my-model"
# Models people may pick with `!model` (empty: switching is off).
models = []
offline = true
work_dir = "/var/lib/aelix-mattermost/workspace"
# Empty disables ALL tools. Every conversation shares this container, its uid and its
# volume: read the security model in docs/docker.md before enabling any tool.
allowed_tools = []
extensions = []
# Example: allowed_tools = ["equipment_summary"]
#          extensions = ["/etc/aelix-mattermost/extensions/equipment.py"]
# Packages built in with --build-arg EXTENSION_PACKAGES are listed by their module:
#          extensions = ["my_aelix_tools"]
# Appended after the built-in Mattermost instructions in the system prompt.
system_prompt = ""
# MCP servers are off unless you name a config file (mount it read-only):
# mcp_config = "/etc/aelix-mattermost/mcp.json"

[gateway]
state_dir = "/var/lib/aelix-mattermost/state"
# "user": a separate transcript per caller AND thread; "thread": shared context.
session_scope = "user"
# Your message while your request runs: "steer" (inject), "interrupt" or "queue".
busy_mode = "steer"
# Progress on the preparing post: "status", "stream" (with the answer so far) or "off".
progress = "status"
thread_history_posts = 30
max_attachments = 10
max_concurrent_runs = 3
# Live Aelix children kept warm (~85 MiB each); keep compose.yaml mem_limit in step.
max_live_processes = 8
max_sessions = 64
max_queue_per_session = 4
idle_timeout = 300
run_timeout = 180
rpc_timeout = 20
startup_timeout = 60
max_tool_calls = 30
max_input_chars = 20000
max_output_chars = 60000
dedup_days = 30

# Optional /aelix slash command (docs/slash-command.md); also enable the port and the
# mattermost_slash_token secret in compose.yaml.
# [slash_command]
# listen = "0.0.0.0:8066"
# token_file = "/run/secrets/mattermost_slash_token"

# Per-channel settings, keyed by channel ID.
# [channels."REPLACE_WITH_A_CHANNEL_ID"]
# prompt = "Answer briefly."
# require_mention = false
# allowed_tools = ["read"]
